{
  // TypeScript language features run on tsrs, the repository's pinned compiler: the TypeScript 7 extension starts
  // .vscode/tsrs/tsgo, which runs node_modules/.bin/tsrs. Lint is the oxc extension: node_modules' oxlint with
  // oxlint.config.ts. Effect diagnostics come from `bun run typecheck` (README.md "Editors").
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./.vscode/tsrs",
  "oxc.enable.oxlint": true,
  // The type-aware rules run on the pinned tsrs-lint that `bun tools/tsrs-lint.ts` caches; the tag equals its pin.
  "oxc.path.tsgolint": "${userHome}/.cache/tsrs-lint/lint-pr624-0acc433-regions.1/tsrs-lint"
}
