  "type": "module",
  "scripts": {
    "check": "bun run format:check && bun run agents:check && bun run graph && bun run migrations:check && bun run dupes && bun run typecheck && bun run lint:gate && bun run test && bun run test:scripts",
    "check:fast": "bun run typecheck && bun run lint",
    "typecheck": "tsc -p scripts/ci/tsconfig.json && tsc -p crew/tsconfig.json && turbo run typecheck",
    "test": "turbo run test --concurrency=2",
    "lint": "oxlint -c oxlint.config.ts .",
    "lint:fix": "oxlint -c oxlint.config.ts --fix .",
    "build": "turbo run build",
    "dev": "alchemy dev --stage local",
    "deploy:dev": "bun scripts/ci/release.ts deploy dev",
    "deploy:prod": "bun scripts/ci/release.ts deploy prod",
    "plan": "bun scripts/ci/release.ts plan",
    "drift": "bun scripts/ci/release.ts drift",
    "smoke": "bun scripts/ci/smoke.ts",
    "ci:typecheck": "tsc -p scripts/ci/tsconfig.json",
    "ci:test": "bun test scripts/ci",
    "alchemy": "alchemy",
    "reality-check": "bun scripts/reality-check.ts",
    "p0:drills": "bun scripts/p0-drills.ts",
    "db:generate": "node scripts/db-generate.mjs",
    "testnet:v1:flows": "bun packages/sdk/scripts/v1-flows.ts",
    "live:deployed": "bun packages/sdk/scripts/live/deployed/acceptance.ts",
    "format": "oxfmt -c oxfmt.config.ts --write",
    "format:check": "oxfmt -c oxfmt.config.ts --check",
    "lint:gate": "bun tools/lint-baseline.ts",
    "lint:report": "bun tools/lint-report.ts",
    "knip": "knip --no-progress",
    "dupes": "jscpd",
    "graph": "bun tools/check-graph.ts",
    "agents:check": "bunx repoagents@1 check && bun tools/agents-check.ts",
    "check:files": "bun scripts/check-files.ts",
    "migrations:check": "bun scripts/migrations-lock.ts check",
    "migrations:record": "bun scripts/migrations-lock.ts record",
    "test:scripts": "bun tools/test-scripts.ts && bun test scripts/ci crew/bin"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
