{
  // Unused files, exports and dependencies: `bun run knip`. Every rule is an error.
  // Entries end in `!` so they count in production mode too.
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "binaries": "error",
    "catalog": "error",
    "catalogReferences": "error",
    "cycles": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "duplicates": "error",
    "enumMembers": "error",
    "exports": "error",
    "files": "error",
    "namespaceMembers": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "optionalPeerDependencies": "error",
    "types": "error",
    "unlisted": "error",
    "unresolved": "error",
  },
  "treatConfigHintsAsErrors": true,
  // Foundry supplies forge/cast/anvil; the acceptance harness invokes the installed Codex CLI; a crew bot's container
  // (crew/sandbox, util-linux) supplies setpriv.
  "ignoreBinaries": ["forge", "anvil", "codex", "setpriv"],
  // Vendored upstream code is maintained as one unit, not pruned by repository gates.
  "ignore": [
    // Foundry dependencies and generated outputs are not Sidequest TypeScript sources.
    "contracts/lib/**",
    "tools/oxlint/anti-slop/**",
    // Vendored agent skills (scripts, assets) are upstream files, not Sidequest sources.
    ".agents/skills/**",
  ],
  "workspaces": {
    ".": {
      // Operator CLIs, generators and the deployment stack run directly rather than through imports.
      "entry": [
        "alchemy.run.ts!",
        "scripts/preflight-prod.ts!",
        "scripts/ci/*.ts!",
        "scripts/gen-*.mjs!",
        "scripts/*.mjs!",
        "scripts/*.ts!",
        // Operator commands run by hand from the runbooks: contracts.mjs (deploy-plan, deploy, promote, accept,
        // verify) and testnet-setup.mjs (G1d seeding). Knip cannot see a human caller.
        "scripts/sidequest/*.mjs!",
        // Live probes and outside-agent examples, run by hand: bun scripts/probes/<name>.ts.
        "scripts/probes/*.ts!",
        "crew/bin/*.ts!",
        // Isolated preview CLI, manual browser check and Bun.build browser entry; not imported by shipped apps.
        "spikes/commons-durable-runs/{server,browser-check,ui}.ts!",
      ],
    },
    "tools": {
      // Root scripts load these CLIs; oxlint loads the repository plugins by filename.
      "entry": ["*.ts!", "oxlint/*.ts!"],
    },
    "packages/sdk": {
      // Developer/operator scripts are invoked directly with Bun.
      "entry": ["scripts/**/*.ts!"],
    },
    // The globs include main.tsx/main.ts, also discovered by Vite and script plugins; avoid redundant literal entries.
    "apps/explore": {
      "entry": [
        "worker.ts!",
        "src/{main,index}.tsx!",
        // Vite serves this widget as /embed.js; Boards emits its script URL.
        "public/embed.js!",
        // Manual generators own the committed brand icons, token logos and showcase images.
        "scripts/icons.ts!",
        "scripts/tokens.ts!",
        "scripts/showcase.ts!",
        // Browserless docs/Worker smoke tool, invoked directly by the docs operator.
        "scripts/docs-smoke.mjs!",
      ],
    },
    "apps/api": {
      // gen-hiring.mjs reads this as text and embeds it in the MCP App HTML.
      "entry": ["src/hiring/panel.js!"],
    },
    "apps/docs": {
      "entry": [
        // gen-docs.mjs loads exportDocs through Vite's ssrLoadModule.
        "src/lib/export.ts!",
      ],
      // Type declarations for site-output.mjs, consumed by the docs output verifier.
      "ignore": ["site-output.d.mts"],
    },
    "apps/arbiter": { "entry": ["src/{main,index}.ts!"] },
    "contracts": {
      // Foundry operator scripts live alongside Solidity; Bun invokes these TypeScript files directly.
      // G1d refund operator scripts (manifest, batch) are run by hand from the G1d runbook.
      "entry": ["script/**/*.ts!", "script/refund-*.mjs!"],
    },
  },
}
